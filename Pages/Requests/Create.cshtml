@page
@model Donation.Pages.Requests.CreateModel
@{
    ViewData["Title"] = "تسجيل طلب مساعدة";
}

<div class="theme-eyebrow eyebrow-beneficiary">لوحة المستفيد</div>
<h2>تسجيل طلب مساعدة جديد</h2>

<form method="post">
    <div class="theme-field">
        <label asp-for="NewRequest.Category">الفئة</label>
        <select asp-for="NewRequest.Category">
            <option value="">-- اختر الفئة --</option>
            <option value="طعام">طعام</option>
            <option value="علاج">علاج</option>
            <option value="مستلزمات صحية">مستلزمات صحية</option>
            <option value="ايواء">ايواء</option>
            <option value="مياه">مياه</option>
            <option value="ملابس">ملابس</option>
        </select>
        <span asp-validation-for="NewRequest.Category" class="text-danger"></span>
    </div>
    <div class="theme-field">
        <label asp-for="NewRequest.FamilySize">عدد أفراد الأسرة</label>
        <input asp-for="NewRequest.FamilySize" type="number"/>
        <span asp-validation-for="NewRequest.FamilySize" class="text-danger"></span>
    </div>
    <div class="theme-field">
        <label asp-for="NewRequest.UrgencyLevel">مستوى الحاجة</label>
        <select asp-for="NewRequest.UrgencyLevel">
            <option value="">-- مستوى الحاجة --</option>
            <option value="1">منخفض</option>
            <option value="2">متوسط</option>
            <option value="3">عالي</option>
        </select>
        <span asp-validation-for="NewRequest.UrgencyLevel" class="text-danger"></span>
    </div>
    <div class="theme-field">
        <label asp-for="NewRequest.Description">الوصف</label>
        <textarea asp-for="NewRequest.Description"></textarea>
        <span asp-validation-for="NewRequest.Description" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-accent-beneficiary">إرسال الطلب</button>
</form>
