@using Donation.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    @if (User.IsInRole("Beneficiary"))
      {
        <li class="nav-item">
           <a class="nav-link text-light" asp-page="/Requests/Index">طلباتي</a>
        </li>
      }
    @if (User.IsInRole("Donor"))
      {
        <li class="nav-item">
           <a class="nav-link text-light" asp-page="/Donations/Index">تصفح التبرعات</a>
        </li>
      }
    @if (User.IsInRole("Donor"))
      {
        <li class="nav-item">
           <a class="nav-link text-light" asp-page="/Donations/MyDonations">تبرعاتي</a>
        </li>
      }
    @if (User.IsInRole("Coordinator"))
      {
        <li class="nav-item">
           <a class="nav-link text-light" asp-page="/Coordinator/Index">لوحة التحكم</a>
        </li>
      }
    <li class="nav-item">
        <a class="nav-link text-light" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">مرحبا @User.Identity?.Name!</a>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
            <button type="submit" class="nav-link btn btn-link text-light">تسجيل خروج</button>
        </form>
    </li>

}
else
{
    <li class="nav-item">
            <a class="nav-link text-light" asp-area="Identity" asp-page="/Account/Register">إنشاء حساب</a>
    </li>
    <li class="nav-item">
       <a class="nav-link text-light" asp-area="Identity" asp-page="/Account/Login">تسجيل دخول</a>
    </li>
}
</ul>
