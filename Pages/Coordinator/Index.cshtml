@page
@model Donation.Pages.Coordinator.IndexModel
@{
}
<div class="theme-eyebrow eyebrow-coordinator">لوحة التنسيق</div>
<h2>كل الطلبات</h2>

<table class="theme-table">
    <thead>
        <tr>
            <th>الفئة</th>
            <th>الوصف</th>
            <th>عدد افراد الاسرة</th>
            <th>مستوى الحاجة</th>
            <th>الحالة</th>
            <th>تاريخ التقديم</th>
            <th>الاجراءات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var request in Model.AllRequests)
        {
            <tr>
                <td>@request.Category</td>
                <td>@request.Description</td>
                <td>@request.FamilySize</td>
                <td>@request.UrgencyLevel</td>
                <td>
                    @{
                        var badgeClass = request.Status switch
                        {
                            "Submitted" => "status-submitted",
                            "Verified" => "status-verified",
                            "Matched" => "status-matched",
                            "Delivered" => "status-delivered",
                            _ => ""
                        };
                    }
                    <span class="status-badge @badgeClass">@request.Status</span>
                    
                </td>
                <td>@request.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    @if (request.Status != "Delivered")
                    {
                        <a asp-page="/Coordinator/ChangeStatus" asp-route-id="@request.Id" class="btn btn-accent-coordinator">تغيير الحالة</a>
                    }
                    @if (request.Status == "Delivered" && Model.DeliveredWithDistribution.Contains(request.Id))
                    {
                        <span class="status-badge status-delivered">تم التسليم</span>
                    }
                    @if (request.Status == "Delivered" && !Model.DeliveredWithDistribution.Contains(request.Id))
                    {
                        <a asp-page="/Coordinator/ConfirmDelivery" asp-route-id="@request.Id" class="btn btn-accent-coordinator">تاكيد التوصيل</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>