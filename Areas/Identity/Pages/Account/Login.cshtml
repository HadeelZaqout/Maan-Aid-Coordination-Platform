@page
@model LoginModel

@{
    ViewData["Title"] = "تسجيل الدخول";
}

<div class="container mt-4" style="max-width: 480px;">
    <div class="theme-card">
        <div class="theme-card-header">
            <h4 class="mb-0">تسجيل الدخول</h4>
        </div>
        <div class="theme-card-body">
            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="theme-field">
                    <label asp-for="Input.Email">البريد الإلكتروني</label>
                    <input asp-for="Input.Email" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="theme-field">
                    <label asp-for="Input.Password">كلمة المرور</label>
                    <input asp-for="Input.Password" autocomplete="current-password" aria-required="true" placeholder="كلمة المرور" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.RememberMe">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        تذكرني
                    </label>
                </div>

                <button id="login-submit" type="submit" class="w-100 btn btn-primary">تسجيل الدخول</button>

                <div class="mt-3 text-center">
                    <p><a id="forgot-password" asp-page="./ForgotPassword">نسيت كلمة المرور؟</a></p>
                    <p><a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">إنشاء حساب جديد</a></p>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}